@namespace DevToys.Blazor.Pages.SubPages
@using DevToys.Localization.Strings.ToolGroupPage;
@using DevToys.Localization.Strings.MainWindow;
@using DevToys.Blazor.Core.Helpers;
@using DevToys.Core.Tools;
@using ToolPageStrings = DevToys.Localization.Strings.ToolPage.ToolPage;
@inherits MefComponentBase

@{ IReadOnlyList<GuiToolInstance> favorites = GuiToolProvider.GetFavoriteTools(); }

@if (ViewModel.IsAllToolsGroup)
{
    <div id="@HeroId" class="hero"></div>
}

<GridView @ref=_gridView
          Class ="entrance-theme-transition tool-group-grid-view"
          ItemsSource="@ViewModel.Tools"
          ItemMinWidth="330"
          OnItemClick=@OnToolSelected>
    <Header>
        @if (ViewModel.IsAllToolsGroup)
        {
            <StackPanel Orientation="UIOrientation.Horizontal">
                <h1 class="text-block type-title-large no-wrap hero-title">
                    <span>@ToolGroupPage.WelcomeTo</span><span>&nbsp;</span><span>DevToys</span>
                </h1>
                <TextBlock Appearance="@TextBlockAppearance.Caption"
                           NoWrap="true"
                           VerticalAlignment="@UIVerticalAlignment.Bottom"
                           Text="@ToolGroup.DisplayVersionNumber.Value"/>
            </StackPanel>
        }
        else
        {
            <TextBlock Appearance="@TextBlockAppearance.Title" Style="font-size: 24px !important" Text="@ViewModel.HeaderText" />
        }
    </Header>
    <GroupHeaderTemplate Context="item">
        <div class="tool-group-header">
            <TextBlock Appearance="@TextBlockAppearance.Subtitle" Text="@item" />
            @if (ViewModel.IsAllToolsGroup && item == MainWindow.RecentToolsDisplayTitle)
            {
                <Button Appearance="@ButtonAppearance.Stealth"
                        @onclick="GuiToolProvider.ClearRecentTools">
                    @ToolGroupPage.ClearRecentTools
                </Button>
            }
        </div>
    </GroupHeaderTemplate>
    <GroupedItemTemplate Context="context">
        @{
            var item = context.Item;
            bool isFavorite = GuiToolProvider.GetToolIsFavorite(item);
            string favoriteAction = isFavorite ? ToolPageStrings.RemoveFromFavorites : ToolPageStrings.AddToFavorites;
            bool canReorder = isFavorite && (ViewModel.IsFavoriteToolsGroup
                || (ViewModel.IsAllToolsGroup && context.Key != MainWindow.RecentToolsDisplayTitle));
        }
        <div class="tool-group-grid-view-item">
            <div class="icon">
                <FontIcon Height="64"
                          Width="64"
                          FontFamily="@item.IconFontName"
                          Glyph="@item.IconGlyph" />
            </div>
            <div class="title">
                <TextBlock Appearance="@TextBlockAppearance.BodyStrong" Text="@item.LongOrShortDisplayTitle" />
            </div>
            <div class="description">
                <TextBlock Appearance="@TextBlockAppearance.Caption" Text="@item.Description" />
            </div>
            <div class="buttons" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                @if (canReorder)
                {
                    <Button Class="button"
                            IsEnabled="@(favorites.FirstOrDefault() != item)"
                            ToolTip="@ToolGroupPage.MoveFavoriteEarlier"
                            aria-label="@(ToolGroupPage.MoveFavoriteEarlier + ": " + item.LongOrShortDisplayTitle)"
                            @onclick="() => GuiToolProvider.MoveFavoriteTool(item, moveEarlier: true)">
                        <span aria-hidden="true">↑</span>
                    </Button>
                    <Button Class="button"
                            IsEnabled="@(favorites.LastOrDefault() != item)"
                            ToolTip="@ToolGroupPage.MoveFavoriteLater"
                            aria-label="@(ToolGroupPage.MoveFavoriteLater + ": " + item.LongOrShortDisplayTitle)"
                            @onclick="() => GuiToolProvider.MoveFavoriteTool(item, moveEarlier: false)">
                        <span aria-hidden="true">↓</span>
                    </Button>
                }
                @if (!item.NotFavorable)
                {
                    <Button Class="button"
                            ToolTip="@favoriteAction"
                            aria-label="@(favoriteAction + ": " + item.LongOrShortDisplayTitle)"
                            aria-pressed="@(isFavorite ? "true" : "false")"
                            @onclick="() => GuiToolProvider.SetToolIsFavorite(item, !isFavorite)">
                        <FontIcon Class="fonticon" Glyph="@(isFavorite ? '\uF71A' : '\uF70F')" />
                    </Button>
                }
                @if (ViewModel.IsAllToolsGroup && context.Key == MainWindow.RecentToolsDisplayTitle)
                {
                    <Button Class="button"
                            Appearance="@ButtonAppearance.Neutral"
                            ToolTip="@ToolGroupPage.RemoveFromRecentTools"
                            aria-label="@ToolGroupPage.RemoveFromRecentTools"
                            @onclick="() => GuiToolProvider.RemoveRecentTool(item)">
                        <FontIcon Class="fonticon" Glyph="@('\uF369')" />
                    </Button>
                }
                <Button HorizontalAlignment="UIHorizontalAlignment.Right"
                        Class="button"
                        Appearance="@ButtonAppearance.Neutral"
                        ToolTip="@ToolGroupPage.OpenInNewWindow"
                        @onclick="() => OnOpenInNewWindow(item)">
                    <FontIcon Class="fonticon" Glyph="@('\uEE7A')" />
                </Button>
            </div>
        </div>
    </GroupedItemTemplate>
    <Footer>
        @if (ViewModel.IsFavoriteToolsGroup && !GuiToolProvider.GetFavoriteTools().Any())
        {
            <TextBlock Text="@ToolGroupPage.NoFavoriteTools" />
        }
        @if (ViewModel.IsAllToolsGroup)
        {
            <InfoBar Severity="InfoBarSeverity.Informational"
                     IsClosable="false"
                     IsOpened="true"
                     Title="@ToolGroupPage.NotFindingTool"
                     Message="@ToolGroupPage.NotFindingToolOpenFeatureRequest"
                     ActionButtonText="@ToolGroupPage.NotFindingToolSuggestIdea"
                     ActionButtonClicked="@OnSuggestToolIdeaClick" />
        }
    </Footer>
</GridView>
